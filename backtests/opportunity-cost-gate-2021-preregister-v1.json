{
  "schemaVersion": "1.0",
  "experimentId": "opportunity-cost-gate-2021-preregister-v1",
  "validationClass": "historical_holdout_like",
  "purpose": "Test a generic crowded-continuation opportunity-cost block before reading 2021 selection outcomes in this experiment.",
  "frozenRule": {
    "name": "crowded_continuation_block_v1",
    "blockWhenAll": [
      "opportunityTimingTest.lateCycleRisk.conclusion == high",
      "expectationBurdenTest.conclusion == tight",
      "opportunityTimingTest.priceRegime.lookback60Excess >= 0.20"
    ],
    "otherwise": "retain",
    "rationale": "A thesis can be economically correct but offer poor current allocation asymmetry when the sector has already substantially outperformed, late-cycle risk is explicitly high, and the forward expectation burden is tight.",
    "nonGoals": [
      "Do not reject de-rated contrarian candidates merely because current price momentum is weak.",
      "Do not require positive momentum.",
      "Do not change company-quality, causal, or Primary gates.",
      "Do not use sector identity in the rule."
    ]
  },
