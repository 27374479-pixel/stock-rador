  "associationClusters": [
    {
      "clusterId": "macro-slowdown-easing",
      "association": "Growth/manufacturing remained weak while RRR/rate easing intensified. Search only for cases where policy changes a measurable company funding cost, order pool or asset turnover; broad stimulus beta is not enough.",
      "status": "verify"
    },
    {
      "clusterId": "equity-bubble-leverage-liquidity",
      "association": "Record retail participation, extreme technology valuations and margin-financing growth turned into a June deleveraging shock. This is primarily a timing/crowding regime; company longs require earnings independent of speculative liquidity.",
      "status": "market_structure_risk"
    },
    {
      "clusterId": "property-credit-refinancing",
      "association": "Developer dollar-debt stress coexisted with equity refinancing. Search for actual balance-sheet repair or distressed-asset transfer, not safer-developer relative bets.",
      "status": "verify"
    },
    {
      "clusterId": "equity-refinancing-deleveraging",
      "association": "The bull market allowed indebted companies to sell equity and reduce liabilities. Search for companies where refinancing materially removes a balance-sheet constraint and changes forward cash economics.",
      "status": "verify"
    },
    {
      "clusterId": "commodity-input-deflation",
      "association": "Iron ore/copper weakness and domestic mine stress can transfer margins downstream only where end demand/price holds. Search for stable-output-price consumers and reject demand-collapse traps.",
      "status": "company_exception_search"
    },
    {
      "clusterId": "local-debt-swap-funding-cost",
      "association": "Municipal debt swaps plus sharply lower money-market rates reduced local-government financing costs and maturity mismatch. Search for infrastructure/payment chains only when lower financing cost unlocks identifiable projects or reduces credit losses.",
      "status": "verify"
    },
    {
      "clusterId": "ecommerce-mobile-economics",
      "association": "Mobile shopping changed traffic monetization and marketplace economics. Search for logistics, payment, merchant-service or fulfillment bottlenecks with public company conversion; do not infer from platform GMV alone.",
      "status": "verify"
    },
    {
      "clusterId": "made-in-china-2025",
      "association": "A broad industrial-upgrading plan spans robotics, high-end equipment, EVs, rail, power equipment and more. Because thematic equities were already rallying, only fresh company order/backlog conversion with acceptable absorption can survive.",
      "status": "high_crowding_verify"
    },
    {
      "clusterId": "ipo-liquidity-drain",
      "association": "Massive IPO subscriptions temporarily drained trillions of RMB from money markets. Treat as market-liquidity/timing context; any brokerage/financial long must pass extreme crowding checks.",
      "status": "market_structure_context"
    },
    {
      "clusterId": "rmb-internationalization-payment-infrastructure",
      "association": "CIPS and stronger RMB internationalization create real payment/clearing infrastructure needs. Generate bank-IT/clearing hypotheses, but require dated contract/product evidence; broad 'financial IT' association is insufficient.",
      "status": "verify_no_supplier_assumed"
    },
    {
