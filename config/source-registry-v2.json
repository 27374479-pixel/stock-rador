{
  "schemaVersion": "2.0",
  "purpose": "Balanced, research-first discovery registry for A-share weekly opportunity research. This registry expands recall without relaxing downstream selection gates.",
  "independenceRules": [
    "A portal or mirror (Eastmoney, Sina, 10jqka) is transport only; independence belongs to the original broker/research house.",
    "Syndicated Reuters/Bloomberg copies count as one origin.",
    "Company filing plus company IR transcript count as one company-origin group unless independently audited data adds a separate origin.",
    "A research report that merely repeats a filing is interpretation, not a second factual origin for the underlying reported number."
  ],
  "sourceQuorum": {
    "preferredForSelection": [
      "one physical/industry/official state-change source",
      "one company first-party filing or IR source",
      "one independent research report with forward earnings/valuation/expectation analysis"
    ],
    "preferredIndependentOriginGroups": 3,
    "note": "This is an experimental evidence-quality feature, not yet a promotion gate. It must be validated independently before entering the Skill."
  },
