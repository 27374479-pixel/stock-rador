{
  "schemaVersion": "2.0",
  "frozenAt": "2026-09-22T02:46:00.000Z",
  "purpose": "Leakage-controlled validation of community/trade weak signals mapped to A-shares.",
  "selectionRule": {
    "forumRole": "discovery_only",
    "candidateThreshold": 15,
    "minimumExposureScore": 6,
    "minimumSurpriseScore": 4,
    "claimStatusAllowed": ["confirmed", "probable"],
    "noSimplePublicDisclosurePenalty": true,
    "futureOutcomeFieldsForbiddenBeforeSelectionCommit": true
  },
  "sourceClasses": {
    "primary_official": {
      "examples": ["exchange filings", "company filings", "government statistics", "customs", "public tenders", "regulator/industry-association primary data"],
      "use": "truth verification and exposure mapping"
    },
    "professional_data": {
      "examples": ["trade publications with named sources/data", "industry trackers with disclosed methodology", "earnings-call transcripts"],
      "use": "corroboration and magnitude estimation"
    },
    "practitioner_firsthand": {
      "examples": ["working electricians", "data-center operators", "network engineers", "procurement/installer discussions"],
      "use": "early weak-signal discovery"
    },
    "specialist_forum": {
      "examples": ["technical enthusiast/professional communities where identity or firsthand role is uncertain"],
      "use": "discovery; requires stronger corroboration"
    },
    "investor_social": {
      "examples": ["雪球", "东方财富股吧", "general stock forums"],
      "use": "attention/expectations measurement, not factual truth by itself"
    },
    "repost": {
      "examples": ["aggregators", "copied press releases", "same-wire rewrites"],
      "use": "no independent corroboration credit"
    }
  },
  "claimVerification": {
    "independenceRule": "same wire story, same press release, same quoted anonymous source, or copied post share one independenceGroup",
    "requiredChecks": [
      "original URL and historical timestamp",
      "author/role when available",
      "firsthand vs hearsay",
      "specific product/geography/customer/time window",
      "independent corroboration",
      "primary or professional-data cross-check",
      "contradictory evidence search",
      "edit/repost/manipulation flags"
    ]
  },
  "validationWindows": {
